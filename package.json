{
  "name": "tula-closeline-kit",
  "version": "0.3.0",
  "description": "Closeline shared runtime helpers: token verification, queue port and adapters, logging, test fixtures",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "files": [
    "dist"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "scripts": {
    "prepare": "husky || true",
    "build": "bunup",
    "check": "biome check src scripts bench",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "test:coverage": "bun test src --coverage",
    "dist:check": "bash scripts/dist-check.sh",
    "shared:check": "bash .claude/hooks/shared-check.sh",
    "precommit:dist": "bunup && git add dist",
    "verify": "bun run check && bun run typecheck && bun run test:coverage && bun run bench && bun run dist:check && bun run shared:check",
    "verify:changed": "biome check --changed --no-errors-on-unmatched src scripts && bun run typecheck && bun run test",
    "bench": "bun run bench/verify.bench.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "bun-types": "^1.4.2",
    "bunup": "^0.16.32",
    "hono": "^4.13.13",
    "husky": "^9.1.7",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "pino": "^10.4.0",
    "tula-closeline-contract": "git+ssh://git@github.com/Tula-Solutions/tula-closeline-contract.git#v0.3.0"
  },
  "peerDependencies": {
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  }
}
